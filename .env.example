# ==============================================================================
# SYAMS CREATIVE STUDIO — Environment Variables Template
# Jangan pernah menuliskan nilai rahasia asli ke dalam file ini atau Git.
# ==============================================================================

# URL aplikasi (otomatis di-inject oleh platform hosting atau Netlify)
APP_URL="https://syamscreativestudio.netlify.app"

# ------------------------------------------------------------------------------
# Firebase Client SDK (Opsional jika tidak memakai firebase-applet-config.json)
# Nilai ini boleh bersifat publik untuk inisialisasi web SDK.
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# ------------------------------------------------------------------------------
# Firebase Admin SDK (Khusus Backend / Netlify Functions — RAHASIA)
# Gunakan saat menjalankan Netlify Functions di produksi.
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_DATABASE_ID=""

# ------------------------------------------------------------------------------
# Google Drive API OAuth2 Credentials (Khusus Backend / Netlify Functions — RAHASIA)
# Jangan pernah memberi awalan VITE_ pada variabel ini!
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REDIRECT_URI=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
GOOGLE_DRIVE_PUBLIC_FOLDER_ID=""
GOOGLE_DRIVE_PRIVATE_FOLDER_ID=""

# ------------------------------------------------------------------------------
# Keamanan Endpoint Backend
# ------------------------------------------------------------------------------
ALLOWED_ORIGIN="http://localhost:3000"
