rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrapAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'masagitu233@gmail.com';
    }

    function isAdmin() {
      return isVerifiedUser() && (
        isBootstrapAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidOptionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function isValidOptionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    function isValidOptionalGallery(data) {
      return !('gallery' in data) || (
        data.gallery is list &&
        data.gallery.size() <= 12 &&
        (
          data.gallery.size() == 0 || (
            data.gallery[0] is map &&
            data.gallery[0].keys().hasAll(['fileId', 'fileName', 'mimeType']) &&
            data.gallery[0].keys().hasOnly(['fileId', 'fileName', 'mimeType', 'caption', 'imageUrl']) &&
            data.gallery[0].fileId is string &&
            data.gallery[0].fileId.size() >= 3 &&
            data.gallery[0].fileId.size() <= 200 &&
            data.gallery[0].fileName is string &&
            data.gallery[0].fileName.size() >= 1 &&
            data.gallery[0].fileName.size() <= 200 &&
            data.gallery[0].mimeType is string &&
            data.gallery[0].mimeType.size() >= 3 &&
            data.gallery[0].mimeType.size() <= 100
          )
        )
      );
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints (Pillar 2 & Pillar 5)
    // -------------------------------------------------------------------------
    function isValidAdmin(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 200 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.role == 'super_admin' &&
        data.createdAt is timestamp;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'whatsapp', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'whatsapp', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 200 &&
        isValidOptionalString(data, 'photoURL', 500) &&
        data.whatsapp is string && data.whatsapp.size() <= 25 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidService(data) {
      return data.keys().hasAll([
          'slug', 'title', 'category', 'shortDescription', 'fullDescription',
          'priceMin', 'priceMax', 'priceUnit', 'priceLabel', 'estimatedTurnaround',
          'deliverables', 'accentColor', 'imageUrl', 'sortOrder', 'isFeatured',
          'isPublished', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'slug', 'title', 'category', 'shortDescription', 'fullDescription',
          'priceMin', 'priceMax', 'priceUnit', 'priceLabel', 'estimatedTurnaround',
          'deliverables', 'accentColor', 'imageUrl', 'driveFileId', 'gallery', 'sortOrder',
          'isFeatured', 'isPublished', 'createdAt', 'updatedAt'
        ]) &&
        data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 80 && data.slug.matches('^[a-z0-9\\-]+$') &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 140 &&
        data.category in ['web_app', 'video', 'desain', 'presentasi', 'naskah'] &&
        data.shortDescription is string && data.shortDescription.size() >= 10 && data.shortDescription.size() <= 320 &&
        data.fullDescription is string && data.fullDescription.size() >= 20 && data.fullDescription.size() <= 3000 &&
        data.priceMin is number && data.priceMin >= 0 && data.priceMin <= 1000000000 &&
        data.priceMax is number && data.priceMax >= data.priceMin && data.priceMax <= 1000000000 &&
        data.priceUnit is string && data.priceUnit.size() >= 1 && data.priceUnit.size() <= 40 &&
        data.priceLabel is string && data.priceLabel.size() >= 3 && data.priceLabel.size() <= 100 &&
        data.estimatedTurnaround is string && data.estimatedTurnaround.size() >= 2 && data.estimatedTurnaround.size() <= 60 &&
        data.deliverables is list && data.deliverables.size() >= 1 && data.deliverables.size() <= 12 &&
        data.deliverables[0] is string && data.deliverables[0].size() <= 180 &&
        data.accentColor in ['#0F3D3A', '#6C151E', '#8ACCD5', '#F3C95B'] &&
        data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 500 &&
        isValidOptionalString(data, 'driveFileId', 200) &&
        isValidOptionalGallery(data) &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 9999 &&
        data.isFeatured is bool &&
        data.isPublished is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDigitalProduct(data) {
      return data.keys().hasAll([
          'slug', 'title', 'category', 'price', 'showPrice', 'format',
          'fileSize', 'compatibility', 'summary', 'description', 'includes',
          'imageUrl', 'isFeatured', 'isPublished', 'sortOrder',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'slug', 'title', 'category', 'price', 'showPrice', 'format',
          'fileSize', 'compatibility', 'summary', 'description', 'includes',
          'imageUrl', 'driveFileId', 'gallery', 'isFeatured', 'isPublished', 'sortOrder',
          'createdAt', 'updatedAt'
        ]) &&
        data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 80 && data.slug.matches('^[a-z0-9\\-]+$') &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 140 &&
        data.category in ['template_ppt', 'template_poster', 'ui_web_kit', 'aset_video', 'naskah_siap_pakai'] &&
        data.price is number && data.price >= 0 && data.price <= 1000000000 &&
        data.showPrice is bool &&
        data.format is string && data.format.size() >= 1 && data.format.size() <= 80 &&
        data.fileSize is string && data.fileSize.size() <= 40 &&
        data.compatibility is string && data.compatibility.size() <= 160 &&
        data.summary is string && data.summary.size() >= 5 && data.summary.size() <= 320 &&
        data.description is string && data.description.size() >= 10 && data.description.size() <= 3000 &&
        data.includes is list && data.includes.size() >= 1 && data.includes.size() <= 15 &&
        data.includes[0] is string && data.includes[0].size() <= 200 &&
        data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 500 &&
        isValidOptionalString(data, 'driveFileId', 200) &&
        isValidOptionalGallery(data) &&
        data.isFeatured is bool &&
        data.isPublished is bool &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 9999 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'orderCode', 'customerUid', 'customerName', 'customerEmail', 'customerWhatsapp',
          'serviceId', 'serviceTitle', 'estimatedPriceLabel', 'quantityEstimate',
          'projectTitle', 'projectBrief', 'deadline', 'status', 'finalPrice',
          'adminNote', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'orderCode', 'customerUid', 'customerName', 'customerEmail', 'customerWhatsapp',
          'serviceId', 'serviceTitle', 'estimatedPriceLabel', 'quantityEstimate',
          'projectTitle', 'projectBrief', 'deadline', 'attachmentName',
          'attachmentDriveFileId', 'attachmentUrl', 'status', 'finalPrice',
          'adminNote', 'createdAt', 'updatedAt'
        ]) &&
        data.orderCode is string && data.orderCode.size() >= 8 && data.orderCode.size() <= 32 && data.orderCode.matches('^SCS-[0-9]{8}-[A-Z0-9]{4,8}$') &&
        isValidId(data.customerUid) &&
        data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120 &&
        data.customerEmail is string && data.customerEmail.size() >= 5 && data.customerEmail.size() <= 200 &&
        data.customerWhatsapp is string && (data.customerWhatsapp.size() == 0 || (data.customerWhatsapp.size() >= 9 && data.customerWhatsapp.size() <= 25)) &&
        isValidId(data.serviceId) &&
        data.serviceTitle is string && data.serviceTitle.size() >= 3 && data.serviceTitle.size() <= 140 &&
        data.estimatedPriceLabel is string && data.estimatedPriceLabel.size() >= 3 && data.estimatedPriceLabel.size() <= 100 &&
        data.quantityEstimate is number && data.quantityEstimate >= 1 && data.quantityEstimate <= 1000 &&
        data.projectTitle is string && data.projectTitle.size() >= 3 && data.projectTitle.size() <= 160 &&
        data.projectBrief is string && data.projectBrief.size() >= 15 && data.projectBrief.size() <= 3000 &&
        data.deadline is string && data.deadline.size() >= 8 && data.deadline.size() <= 30 &&
        isValidOptionalString(data, 'attachmentName', 200) &&
        isValidOptionalString(data, 'attachmentDriveFileId', 200) &&
        isValidOptionalString(data, 'attachmentUrl', 500) &&
        data.status in [
          'menunggu_konfirmasi', 'harga_dikonfirmasi', 'dalam_pengerjaan',
          'revisi', 'selesai', 'dibatalkan'
        ] &&
        (data.finalPrice == null || (data.finalPrice is number && data.finalPrice >= 0 && data.finalPrice <= 1000000000)) &&
        data.adminNote is string && data.adminNote.size() <= 1500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPortfolio(data) {
      return data.keys().hasAll([
          'title', 'clientName', 'category', 'year', 'summary', 'outcome',
          'metrics', 'imageUrl', 'isFeatured', 'isPublished', 'sortOrder',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'clientName', 'category', 'year', 'summary', 'challenge',
          'outcome', 'metrics', 'imageUrl', 'driveFileId', 'gallery', 'projectUrl',
          'isFeatured', 'isPublished', 'sortOrder', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 140 &&
        data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 100 &&
        data.category in ['web_app', 'video', 'desain', 'presentasi', 'naskah'] &&
        data.year is string && data.year.size() >= 4 && data.year.size() <= 10 &&
        data.summary is string && data.summary.size() >= 10 && data.summary.size() <= 350 &&
        isValidOptionalString(data, 'challenge', 1200) &&
        data.outcome is string && data.outcome.size() >= 5 && data.outcome.size() <= 1200 &&
        data.metrics is string && data.metrics.size() >= 2 && data.metrics.size() <= 120 &&
        data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 500 &&
        isValidOptionalString(data, 'driveFileId', 200) &&
        isValidOptionalGallery(data) &&
        isValidOptionalString(data, 'projectUrl', 500) &&
        data.isFeatured is bool &&
        data.isPublished is bool &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 9999 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMedia(data) {
      return data.keys().hasAll([
          'fileId', 'fileName', 'mimeType', 'sizeBytes', 'visibility',
          'usage', 'ownerUid', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'fileId', 'fileName', 'mimeType', 'sizeBytes', 'visibility',
          'usage', 'altText', 'folderId', 'folderPath', 'entityType',
          'entityId', 'entityName', 'isPublished', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        data.fileId is string && data.fileId.size() >= 3 && data.fileId.size() <= 200 &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 200 &&
        data.mimeType is string && data.mimeType.size() >= 3 && data.mimeType.size() <= 100 &&
        data.sizeBytes is number && data.sizeBytes >= 0 && data.sizeBytes <= 104857600 &&
        data.visibility in ['public', 'private'] &&
        data.usage in ['service', 'product', 'portfolio', 'hero', 'order_attachment', 'other'] &&
        isValidOptionalString(data, 'altText', 240) &&
        isValidOptionalString(data, 'folderId', 200) &&
        isValidOptionalString(data, 'folderPath', 260) &&
        (!('entityType' in data) || data.entityType in ['product', 'service', 'portfolio', 'hero', 'none']) &&
        isValidOptionalString(data, 'entityId', 128) &&
        isValidOptionalString(data, 'entityName', 140) &&
        isValidOptionalBool(data, 'isPublished') &&
        isValidId(data.ownerUid) &&
        data.createdAt is timestamp &&
        isValidOptionalTimestamp(data, 'updatedAt');
    }

    function isValidDriveFolder(data) {
      return data.keys().hasAll([
          'folderKey', 'folderId', 'folderName', 'category', 'folderPath', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'folderKey', 'folderId', 'folderName', 'parentFolderId', 'category',
          'entityId', 'folderPath', 'updatedAt'
        ]) &&
        isValidId(data.folderKey) &&
        data.folderId is string && data.folderId.size() >= 3 && data.folderId.size() <= 200 &&
        data.folderName is string && data.folderName.size() >= 1 && data.folderName.size() <= 160 &&
        isValidOptionalString(data, 'parentFolderId', 200) &&
        data.category in ['root', 'service', 'product', 'portfolio', 'hero', 'order_attachment', 'other'] &&
        isValidOptionalString(data, 'entityId', 128) &&
        data.folderPath is string && data.folderPath.size() >= 1 && data.folderPath.size() <= 260 &&
        data.updatedAt is timestamp;
    }

    function isValidOptionalVisualTheme(data) {
      return !('visualTheme' in data) || data.visualTheme in ['neo_brutalist', 'clean_bento'];
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll([
          'studioName', 'slogan', 'heroHeadline', 'heroSubheadline', 'aboutSummary',
          'whatsappNumber', 'email', 'address', 'operatingHours', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'studioName', 'slogan', 'heroHeadline', 'heroSubheadline', 'heroImageUrl',
          'heroDriveFileId', 'aboutSummary', 'aboutMission', 'whatsappNumber', 'email',
          'address', 'operatingHours', 'instagramUrl', 'tiktokUrl', 'youtubeUrl',
          'linkedinUrl', 'servicesMigrated', 'productsMigrated', 'portfolioMigrated',
          'faqsMigrated', 'visualTheme', 'updatedAt'
        ]) &&
        data.studioName is string && data.studioName.size() >= 2 && data.studioName.size() <= 100 &&
        data.slogan is string && data.slogan.size() >= 3 && data.slogan.size() <= 160 &&
        data.heroHeadline is string && data.heroHeadline.size() >= 5 && data.heroHeadline.size() <= 200 &&
        data.heroSubheadline is string && data.heroSubheadline.size() >= 10 && data.heroSubheadline.size() <= 500 &&
        isValidOptionalString(data, 'heroImageUrl', 500) &&
        isValidOptionalString(data, 'heroDriveFileId', 200) &&
        data.aboutSummary is string && data.aboutSummary.size() >= 10 && data.aboutSummary.size() <= 1500 &&
        isValidOptionalString(data, 'aboutMission', 1200) &&
        data.whatsappNumber is string && data.whatsappNumber.size() >= 8 && data.whatsappNumber.size() <= 30 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 200 &&
        data.address is string && data.address.size() >= 4 && data.address.size() <= 240 &&
        data.operatingHours is string && data.operatingHours.size() >= 4 && data.operatingHours.size() <= 120 &&
        isValidOptionalString(data, 'instagramUrl', 300) &&
        isValidOptionalString(data, 'tiktokUrl', 300) &&
        isValidOptionalString(data, 'youtubeUrl', 300) &&
        isValidOptionalString(data, 'linkedinUrl', 300) &&
        isValidOptionalBool(data, 'servicesMigrated') &&
        isValidOptionalBool(data, 'productsMigrated') &&
        isValidOptionalBool(data, 'portfolioMigrated') &&
        isValidOptionalBool(data, 'faqsMigrated') &&
        isValidOptionalVisualTheme(data) &&
        data.updatedAt is timestamp;
    }

    function isValidFaq(data) {
      return data.keys().hasAll([
          'question', 'answer', 'category', 'sortOrder', 'isPublished', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'question', 'answer', 'category', 'sortOrder', 'isPublished', 'createdAt', 'updatedAt'
        ]) &&
        data.question is string && data.question.size() >= 5 && data.question.size() <= 260 &&
        data.answer is string && data.answer.size() >= 10 && data.answer.size() <= 2000 &&
        data.category in ['pemesanan', 'harga', 'revisi', 'teknis'] &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 9999 &&
        data.isPublished is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll([
          'actorUid', 'actorEmail', 'action', 'entityType', 'entityId', 'summary', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'actorUid', 'actorEmail', 'action', 'entityType', 'entityId', 'summary', 'createdAt'
        ]) &&
        isValidId(data.actorUid) &&
        data.actorEmail is string && data.actorEmail.size() >= 5 && data.actorEmail.size() <= 200 &&
        data.action is string && data.action.size() >= 2 && data.action.size() <= 80 &&
        data.entityType in ['order', 'service', 'product', 'portfolio', 'media', 'faq', 'site_settings', 'admin', 'contact'] &&
        data.entityId is string && data.entityId.size() >= 1 && data.entityId.size() <= 128 &&
        data.summary is string && data.summary.size() >= 3 && data.summary.size() <= 400 &&
        data.createdAt is timestamp;
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll(['name', 'email', 'subject', 'message', 'status', 'createdAt']) &&
        data.keys().hasOnly(['name', 'email', 'whatsapp', 'subject', 'message', 'status', 'createdAt']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 200 &&
        isValidOptionalString(data, 'whatsapp', 25) &&
        data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 160 &&
        data.message is string && data.message.size() >= 10 && data.message.size() <= 2000 &&
        data.status in ['baru', 'dibalas', 'arsip'] &&
        data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    // 1. Admins (Single admin / manually registered UIDs; no public signup)
    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && isValidId(adminId) && isValidAdmin(incoming()) &&
        incoming().uid == adminId &&
        incoming().createdAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() && isValidId(adminId) && isValidAdmin(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email']);
      allow delete: if isVerifiedUser() && isValidId(adminId) && isAdmin() && request.auth.uid != adminId;
    }

    // 2. Customers (Strict PII isolation)
    match /customers/{customerId} {
      allow get: if isVerifiedUser() && isValidId(customerId) && (request.auth.uid == customerId || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && isValidId(customerId) &&
        request.auth.uid == customerId &&
        isValidCustomer(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(customerId) && isValidCustomer(incoming()) && (
        (
          request.auth.uid == customerId &&
          incoming().uid == existing().uid &&
          incoming().email == existing().email &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'whatsapp', 'updatedAt'])
        ) || (
          isAdmin() &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'whatsapp', 'updatedAt'])
        )
      );
      allow delete: if isVerifiedUser() && isValidId(customerId) && isAdmin();
    }

    // 3. Services (Dynamic pricing catalog managed by Admin)
    match /services/{serviceId} {
      allow get: if isValidId(serviceId) && (existing().isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create: if isVerifiedUser() && isValidId(serviceId) && isValidService(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() && isValidId(serviceId) && isValidService(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'slug', 'title', 'category', 'shortDescription', 'fullDescription',
          'priceMin', 'priceMax', 'priceUnit', 'priceLabel', 'estimatedTurnaround',
          'deliverables', 'accentColor', 'imageUrl', 'driveFileId', 'gallery', 'sortOrder',
          'isFeatured', 'isPublished', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(serviceId) && isAdmin();
    }

    // 3b. Digital Products (Managed by Admin; public reads published only)
    match /digital_products/{productId} {
      allow get: if isValidId(productId) && (existing().isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create: if isVerifiedUser() && isValidId(productId) && isValidDigitalProduct(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() && isValidId(productId) && isValidDigitalProduct(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'slug', 'title', 'category', 'price', 'showPrice', 'format',
          'fileSize', 'compatibility', 'summary', 'description', 'includes',
          'imageUrl', 'driveFileId', 'gallery', 'isFeatured', 'isPublished', 'sortOrder',
          'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(productId) && isAdmin();
    }

    // 4. Orders (Customer owns own orders; Admin confirms final price & status)
    match /orders/{orderId} {
      allow get: if isVerifiedUser() && isValidId(orderId) && (existing().customerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.customerUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && isValidId(orderId) && isValidOrder(incoming()) &&
        incoming().customerUid == request.auth.uid &&
        incoming().status == 'menunggu_konfirmasi' &&
        incoming().finalPrice == null &&
        incoming().adminNote == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(orderId) && isValidOrder(incoming()) && (
        // Action 1: Admin confirms price / updates workflow status / adds note
        (
          isAdmin() &&
          incoming().customerUid == existing().customerUid &&
          incoming().orderCode == existing().orderCode &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'finalPrice', 'adminNote', 'updatedAt'])
        ) ||
        // Action 2: Customer cancels pending order before confirmation (terminal-state locked)
        (
          existing().customerUid == request.auth.uid &&
          existing().status == 'menunggu_konfirmasi' &&
          incoming().status == 'dibatalkan' &&
          incoming().customerUid == existing().customerUid &&
          incoming().orderCode == existing().orderCode &&
          incoming().finalPrice == existing().finalPrice &&
          incoming().adminNote == existing().adminNote &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        )
      );
      allow delete: if isVerifiedUser() && isValidId(orderId) && isAdmin();
    }

    // 5. Portfolio
    match /portfolio/{portfolioId} {
      allow get: if isValidId(portfolioId) && (existing().isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create: if isVerifiedUser() && isValidId(portfolioId) && isValidPortfolio(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() && isValidId(portfolioId) && isValidPortfolio(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'clientName', 'category', 'year', 'summary', 'challenge',
          'outcome', 'metrics', 'imageUrl', 'driveFileId', 'gallery', 'projectUrl',
          'isFeatured', 'isPublished', 'sortOrder', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(portfolioId) && isAdmin();
    }

    // 6. Media (Google Drive metadata; public vs private separation)
    match /media/{mediaId} {
      allow get: if isValidId(mediaId) && (
        existing().visibility == 'public' ||
        (isVerifiedUser() && existing().ownerUid == request.auth.uid) ||
        isAdmin()
      );
      allow list: if resource.data.visibility == 'public' ||
        (isVerifiedUser() && resource.data.ownerUid == request.auth.uid) ||
        isAdmin();
      allow create: if isVerifiedUser() && isValidId(mediaId) && isValidMedia(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        (!('updatedAt' in incoming()) || incoming().updatedAt == request.time) && (
          isAdmin() ||
          (incoming().visibility == 'private' && incoming().usage == 'order_attachment')
        );
      allow update: if isVerifiedUser() && isValidId(mediaId) && isValidMedia(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        (!('updatedAt' in incoming()) || incoming().updatedAt == request.time) &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'fileId', 'fileName', 'mimeType', 'sizeBytes', 'visibility', 'usage',
          'altText', 'folderId', 'folderPath', 'entityType', 'entityId',
          'entityName', 'isPublished', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(mediaId) && isAdmin();
    }

    // 6b. Drive Folders Cache (Admin-only Google Drive folder ID mapping)
    match /drive_folders/{folderKey} {
      allow get: if isValidId(folderKey) && isAdmin();
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && isValidId(folderKey) && isValidDriveFolder(incoming()) &&
        incoming().folderKey == folderKey &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() && isValidId(folderKey) && isValidDriveFolder(incoming()) &&
        incoming().folderKey == existing().folderKey &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'folderId', 'folderName', 'parentFolderId', 'category', 'entityId', 'folderPath', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(folderKey) && isAdmin();
    }

    // 7. Site Settings (Public studio info; Admin write only)
    match /site_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;
      allow create: if isVerifiedUser() && isValidId(settingId) && isValidSiteSettings(incoming()) &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() && isValidId(settingId) && isValidSiteSettings(incoming()) &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'studioName', 'slogan', 'heroHeadline', 'heroSubheadline', 'heroImageUrl',
          'heroDriveFileId', 'aboutSummary', 'aboutMission', 'whatsappNumber', 'email',
          'address', 'operatingHours', 'instagramUrl', 'tiktokUrl', 'youtubeUrl',
          'linkedinUrl', 'servicesMigrated', 'productsMigrated', 'portfolioMigrated',
          'faqsMigrated', 'visualTheme', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // 8. FAQs
    match /faqs/{faqId} {
      allow get: if isValidId(faqId) && (existing().isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create: if isVerifiedUser() && isValidId(faqId) && isValidFaq(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() && isValidId(faqId) && isValidFaq(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'question', 'answer', 'category', 'sortOrder', 'isPublished', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(faqId) && isAdmin();
    }

    // 9. Activity Logs (Append-only immutable audit log for Admins)
    match /activity_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && isValidId(logId) && isValidActivityLog(incoming()) &&
        incoming().actorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    // 10. Contact Messages (Public submit; Admin triage only)
    match /contact_messages/{messageId} {
      allow get: if isValidId(messageId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(messageId) && isValidContactMessage(incoming()) &&
        incoming().status == 'baru' &&
        incoming().createdAt == request.time;
      allow update: if isVerifiedUser() && isValidId(messageId) && isValidContactMessage(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isVerifiedUser() && isValidId(messageId) && isAdmin();
    }
  }
}
