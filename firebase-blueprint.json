{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Administrator utama SYAMS CREATIVE STUDIO yang didaftarkan secara manual berdasarkan UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["super_admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Profil pribadi pelanggan yang masuk menggunakan Google Sign-In saat checkout.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "whatsapp": {
          "type": "string",
          "maxLength": 25
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "whatsapp", "createdAt", "updatedAt"]
    },
    "Service": {
      "title": "Service",
      "description": "Layanan digital beserta estimasi harga dinamis yang dikelola admin melalui Firestore.",
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "pattern": "^[a-z0-9\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140
        },
        "category": {
          "type": "string",
          "enum": ["web_app", "video", "desain", "presentasi", "naskah"]
        },
        "shortDescription": {
          "type": "string",
          "minLength": 10,
          "maxLength": 320
        },
        "fullDescription": {
          "type": "string",
          "minLength": 20,
          "maxLength": 3000
        },
        "priceMin": {
          "type": "number"
        },
        "priceMax": {
          "type": "number"
        },
        "priceUnit": {
          "type": "string",
          "maxLength": 40
        },
        "priceLabel": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100
        },
        "estimatedTurnaround": {
          "type": "string",
          "maxLength": 60
        },
        "deliverables": {
          "type": "array"
        },
        "accentColor": {
          "type": "string",
          "enum": ["#0F3D3A", "#6C151E", "#8ACCD5", "#F3C95B"]
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 500
        },
        "driveFileId": {
          "type": "string",
          "maxLength": 200
        },
        "gallery": {
          "type": "array"
        },
        "sortOrder": {
          "type": "number"
        },
        "isFeatured": {
          "type": "boolean"
        },
        "isPublished": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "slug",
        "title",
        "category",
        "shortDescription",
        "fullDescription",
        "priceMin",
        "priceMax",
        "priceUnit",
        "priceLabel",
        "estimatedTurnaround",
        "deliverables",
        "accentColor",
        "imageUrl",
        "sortOrder",
        "isFeatured",
        "isPublished",
        "createdAt",
        "updatedAt"
      ]
    },
    "DigitalProduct": {
      "title": "DigitalProduct",
      "description": "Produk digital siap pakai (template PPT, poster, web kit, aset video, naskah) yang dikelola admin melalui Firestore.",
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "pattern": "^[a-z0-9\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140
        },
        "category": {
          "type": "string",
          "enum": ["template_ppt", "template_poster", "ui_web_kit", "aset_video", "naskah_siap_pakai"]
        },
        "price": {
          "type": "number"
        },
        "showPrice": {
          "type": "boolean"
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "fileSize": {
          "type": "string",
          "maxLength": 40
        },
        "compatibility": {
          "type": "string",
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 5,
          "maxLength": 320
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 3000
        },
        "includes": {
          "type": "array"
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "driveFileId": {
          "type": "string",
          "maxLength": 200
        },
        "gallery": {
          "type": "array"
        },
        "isFeatured": {
          "type": "boolean"
        },
        "isPublished": {
          "type": "boolean"
        },
        "sortOrder": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "slug",
        "title",
        "category",
        "price",
        "showPrice",
        "format",
        "fileSize",
        "compatibility",
        "summary",
        "description",
        "includes",
        "imageUrl",
        "isFeatured",
        "isPublished",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "Data pemesanan jasa digital pelanggan dengan estimasi awal dan konfirmasi harga final oleh admin.",
      "type": "object",
      "properties": {
        "orderCode": {
          "type": "string",
          "minLength": 8,
          "maxLength": 32,
          "pattern": "^SCS-[0-9]{8}-[A-Z0-9]{4,8}$"
        },
        "customerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "customerEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "customerWhatsapp": {
          "type": "string",
          "minLength": 0,
          "maxLength": 25
        },
        "serviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "serviceTitle": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140
        },
        "estimatedPriceLabel": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100
        },
        "quantityEstimate": {
          "type": "number"
        },
        "projectTitle": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "projectBrief": {
          "type": "string",
          "minLength": 15,
          "maxLength": 3000
        },
        "deadline": {
          "type": "string",
          "minLength": 8,
          "maxLength": 30
        },
        "attachmentName": {
          "type": "string",
          "maxLength": 200
        },
        "attachmentDriveFileId": {
          "type": "string",
          "maxLength": 200
        },
        "attachmentUrl": {
          "type": "string",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": [
            "menunggu_konfirmasi",
            "harga_dikonfirmasi",
            "dalam_pengerjaan",
            "revisi",
            "selesai",
            "dibatalkan"
          ]
        },
        "finalPrice": {
          "type": "number"
        },
        "adminNote": {
          "type": "string",
          "maxLength": 1500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "orderCode",
        "customerUid",
        "customerName",
        "customerEmail",
        "customerWhatsapp",
        "serviceId",
        "serviceTitle",
        "estimatedPriceLabel",
        "quantityEstimate",
        "projectTitle",
        "projectBrief",
        "deadline",
        "status",
        "adminNote",
        "createdAt",
        "updatedAt"
      ]
    },
    "PortfolioItem": {
      "title": "PortfolioItem",
      "description": "Karya pilihan SYAMS CREATIVE STUDIO untuk ditampilkan pada halaman publik.",
