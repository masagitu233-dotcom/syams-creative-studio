        "heroSubheadline",
        "aboutSummary",
        "whatsappNumber",
        "email",
        "address",
        "operatingHours",
        "updatedAt"
      ]
    },
    "FaqItem": {
      "title": "FaqItem",
      "description": "Daftar pertanyaan yang sering diajukan oleh calon pelanggan.",
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 5,
          "maxLength": 260
        },
        "answer": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        },
        "category": {
          "type": "string",
          "enum": ["pemesanan", "harga", "revisi", "teknis"]
        },
        "sortOrder": {
          "type": "number"
        },
        "isPublished": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "question",
        "answer",
        "category",
        "sortOrder",
        "isPublished",
        "createdAt",
        "updatedAt"
      ]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Catatan audit aktivitas administrator untuk transparansi perubahan konten dan pesanan.",
      "type": "object",
      "properties": {
        "actorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorEmail": {
          "type": "string",
          "maxLength": 200
        },
        "action": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "entityType": {
          "type": "string",
          "enum": ["order", "service", "product", "portfolio", "media", "faq", "site_settings", "admin", "contact"]
        },
        "entityId": {
          "type": "string",
          "maxLength": 128
        },
        "summary": {
          "type": "string",
          "minLength": 3,
          "maxLength": 400
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "actorUid",
        "actorEmail",
        "action",
        "entityType",
        "entityId",
        "summary",
        "createdAt"
      ]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Pesan pertanyaan yang dikirim melalui halaman Kontak publik.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "whatsapp": {
          "type": "string",
          "maxLength": 25
        },
        "subject": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "message": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": ["baru", "dibalas", "arsip"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "email", "subject", "message", "status", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Dokumen administrator utama yang didaftarkan secara manual berdasarkan UID."
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Profil pribadi pelanggan; hanya dapat diakses pemilik UID dan admin."
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Katalog layanan dan estimasi harga dinamis."
    },
    "/digital_products/{productId}": {
      "schema": { "$ref": "#/entities/DigitalProduct" },
      "description": "Katalog produk digital siap pakai yang dikelola administrator."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Pesanan jasa digital; pelanggan hanya dapat membaca pesanan dengan customerUid miliknya."
    },
    "/portfolio/{portfolioId}": {
      "schema": { "$ref": "#/entities/PortfolioItem" },
      "description": "Portofolio karya studio."
    },
    "/media/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaAsset" },
      "description": "Metadata file Google Drive publik maupun privat beserta kategori, folder, dan relasi entitas."
    },
    "/drive_folders/{folderKey}": {
      "schema": { "$ref": "#/entities/DriveFolder" },
      "description": "Cache ID folder Google Drive untuk struktur SYAMS CREATIVE STUDIO dan subfolder entitas (khusus admin)."
    },
    "/site_settings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Pengaturan konten utama, kontak, dan media sosial studio."
    },
    "/faqs/{faqId}": {
      "schema": { "$ref": "#/entities/FaqItem" },
      "description": "Daftar pertanyaan umum (FAQ)."
    },
    "/activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Log aktivitas administratif yang bersifat append-only."
    },
    "/contact_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Pesan masuk dari halaman Kontak publik."
    }
  }
}
