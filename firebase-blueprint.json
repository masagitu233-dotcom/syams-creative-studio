          "maxLength": 1200
        },
        "outcome": {
          "type": "string",
          "maxLength": 1200
        },
        "metrics": {
          "type": "string",
          "maxLength": 120
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 500
        },
        "driveFileId": {
          "type": "string",
          "maxLength": 200
        },
        "gallery": {
          "type": "array"
        },
        "projectUrl": {
          "type": "string",
          "maxLength": 500
        },
        "isFeatured": {
          "type": "boolean"
        },
        "isPublished": {
          "type": "boolean"
        },
        "sortOrder": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title",
        "clientName",
        "category",
        "year",
        "summary",
        "outcome",
        "metrics",
        "imageUrl",
        "isFeatured",
        "isPublished",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ]
    },
    "MediaAsset": {
      "title": "MediaAsset",
      "description": "Metadata berkas gambar, ilustrasi, atau lampiran yang disimpan pada Google Drive.",
      "type": "object",
      "properties": {
        "fileId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "mimeType": {
          "type": "string",
          "maxLength": 100
        },
        "sizeBytes": {
          "type": "number"
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "private"]
        },
        "usage": {
          "type": "string",
          "enum": ["service", "product", "portfolio", "hero", "order_attachment", "other"]
        },
        "altText": {
          "type": "string",
          "maxLength": 240
        },
        "folderId": {
          "type": "string",
          "maxLength": 200
        },
        "folderPath": {
          "type": "string",
          "maxLength": 260
        },
        "entityType": {
          "type": "string",
          "enum": ["product", "service", "portfolio", "hero", "none"]
        },
        "entityId": {
          "type": "string",
          "maxLength": 128
        },
        "entityName": {
          "type": "string",
          "maxLength": 140
        },
        "isPublished": {
          "type": "boolean"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "fileId",
        "fileName",
        "mimeType",
        "sizeBytes",
        "visibility",
        "usage",
        "ownerUid",
        "createdAt"
      ]
    },
    "DriveFolder": {
      "title": "DriveFolder",
      "description": "Cache struktur folder otomatis Google Drive untuk SYAMS CREATIVE STUDIO agar tidak membuat folder duplikat.",
      "type": "object",
      "properties": {
        "folderKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "folderId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "folderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "parentFolderId": {
          "type": "string",
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "enum": ["root", "service", "product", "portfolio", "hero", "order_attachment", "other"]
        },
        "entityId": {
          "type": "string",
          "maxLength": 128
        },
        "folderPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "folderKey",
        "folderId",
        "folderName",
        "category",
        "folderPath",
        "updatedAt"
      ]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Pengaturan konten utama, kontak, dan tautan media sosial SYAMS CREATIVE STUDIO.",
      "type": "object",
      "properties": {
        "studioName": {
          "type": "string",
          "maxLength": 100
        },
        "slogan": {
          "type": "string",
          "maxLength": 160
        },
        "heroHeadline": {
          "type": "string",
          "maxLength": 200
        },
        "heroSubheadline": {
          "type": "string",
          "maxLength": 500
        },
        "heroImageUrl": {
          "type": "string",
          "maxLength": 500
        },
        "heroDriveFileId": {
          "type": "string",
          "maxLength": 200
        },
        "aboutSummary": {
          "type": "string",
          "maxLength": 1500
        },
        "aboutMission": {
          "type": "string",
          "maxLength": 1200
        },
        "whatsappNumber": {
          "type": "string",
          "maxLength": 30
        },
        "email": {
          "type": "string",
          "maxLength": 200
        },
        "address": {
          "type": "string",
          "maxLength": 240
        },
        "operatingHours": {
